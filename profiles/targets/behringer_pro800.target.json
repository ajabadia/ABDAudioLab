{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "1.0",
  "kind": "abd.target-profile",
  "targetProfileId": "hw-behringer-pro800-canonical",
  "displayName": "Behringer PRO-800",
  "vendor": "Behringer",
  "targetKind": "HardwareDigital",
  "revision": 1,
  "identity": {
    "canonicalTargetId": "hw-behringer-pro800",
    "acceptedUniqueIds": [
      "Behringer PRO-800",
      "PRO-800",
      "PRO 800",
      "hw-pro800"
    ],
    "binaryIdentityPolicy": "not-applicable"
  },
  "capabilities": {
    "midiInput": true,
    "supportsParameterAutomation": true,
    "controlTransports": [
      "MidiContinuousController"
    ],
    "audioOutput": {
      "supportedChannelCounts": [
        1,
        2
      ],
      "requiredChannelCount": 1,
      "channelLayout": "mono",
      "supportedObservationLayouts": [
        "mono",
        "stereo"
      ]
    },
    "sampleRatesHz": [
      44100,
      48000,
      96000
    ],
    "blockSizes": [
      64,
      128,
      256,
      512
    ],
    "supportsPolyphony": true,
    "midiChannels": [
      1
    ],
    "midiNoteRange": [
      0,
      127
    ]
  },
  "parameters": [
    {
      "semanticId": "filter_cutoff",
      "displayName": "Filter Cutoff",
      "technicalIdentifier": {
        "kind": "MidiContinuousController",
        "channel": 1,
        "controllerNumber": 19
      },
      "valueType": "continuous",
      "normalizedRange": [
        0.0,
        1.0
      ],
      "mappingCurve": {
        "kind": "linear"
      },
      "confirmationStatus": "UserConfirmed"
    },
    {
      "semanticId": "filter_resonance",
      "displayName": "Resonance",
      "technicalIdentifier": {
        "kind": "MidiContinuousController",
        "channel": 1,
        "controllerNumber": 21
      },
      "valueType": "continuous",
      "normalizedRange": [
        0.0,
        1.0
      ],
      "mappingCurve": {
        "kind": "linear"
      },
      "confirmationStatus": "UserConfirmed"
    },
    {
      "semanticId": "filter_envelope_amount",
      "displayName": "Filter Envelope Amount",
      "technicalIdentifier": {
        "kind": "MidiContinuousController",
        "channel": 1,
        "controllerNumber": 20
      },
      "valueType": "continuous",
      "normalizedRange": [
        0.0,
        1.0
      ],
      "mappingCurve": {
        "kind": "linear"
      },
      "confirmationStatus": "UserConfirmed"
    }
  ],
  "measurementPolicies": {
    "warmupTimeMs": 30,
    "defaultSettlingTimeMs": 50,
    "recommendedCalibrationPolicy": "None",
    "requiresResetBetweenTrials": false
  },
  "transportPolicy": {
    "minimumInterMessageDelayMs": 5,
    "maximumMessagesPerSecond": 50,
    "requiresResponseAck": false,
    "responseTimeoutMs": 0,
    "retryPolicy": "none",
    "maxRetries": 0,
    "requiresExplicitConfirmation": false,
    "allowsBulkDump": false,
    "requiresVerifiedIdentity": false,
    "allowsUserConfirmedUnverifiedIdentity": true
  },
  "routingGuide": {
    "stimulusOutput": "USB MIDI / 5-pin DIN -> PRO-800 MIDI IN",
    "responseInput": "PRO-800 Main Out (Mono) -> Audio In 1 (L)",
    "notes": "Ensure PRO-800 MIDI channel is set to 1 and Main Volume is ~75%.",
    "steps": [
      "Connect USB cable from PC (or 5-pin DIN from interface) to PRO-800 MIDI IN.",
      "Connect PRO-800 AUDIO OUT to Audio Interface In 1 with 1/4\" TS cable.",
      "Power on PRO-800 and set MASTER VOLUME to 2 o'clock (~75%).",
      "Ensure synth is set to receive on MIDI Channel 1."
    ]
  },
  "lifecycle": {
    "preSessionSetup": [
      {
        "description": "Send MIDI CC 121 (Reset All Controllers)",
        "method": "MIDI_CC",
        "channel": 1,
        "controlNumber": 121,
        "normalizedValue": 0.0,
        "settlingDelayMs": 100
      },
      {
        "description": "Initialize VCF Cutoff to fully open (CC 74 = 127)",
        "method": "MIDI_CC",
        "channel": 1,
        "controlNumber": 74,
        "normalizedValue": 1.0,
        "settlingDelayMs": 50
      },
      {
        "description": "Reset VCF Resonance to 0 (CC 71 = 0)",
        "method": "MIDI_CC",
        "channel": 1,
        "controlNumber": 71,
        "normalizedValue": 0.0,
        "settlingDelayMs": 50
      }
    ]
  }
}
