# Build and temporary files
build/
bin/
out/
.vs/
*.user
*.suo
CMakeSettings.json

# Exported LUTs and raw measurement datasets (RNF-10)
exported_luts/
captures/
*.wav
fixtures/exports/*_20*.h
exports/
experiments/
guided/

# OS and IDE files
.DS_Store
Thumbs.db
.cache/
.vscode/
.aider*

# Shared assets junctions (linked from ../ABDSharedAssets)
# NOTE: contracts/ is deliberately NOT ignored — it is a tracked in-repo snapshot
# required by the hardware contract registry and by the test suite.
assets/brands/
assets/models/
artifacts/
__pycache__/
*.png

# MSVC compiler response files and temporaries. MSVC can drop a *.rsp in the
# source root when a build is interrupted, and those files embed absolute
# include paths of the machine that compiled them: they are build garbage and
# must never be committed.
/*.rsp
/tmp_*.rsp
/tmp_*.obj
